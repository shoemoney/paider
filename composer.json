{
    "name": "paider/paider",
    "description": "A PHP-native AI coding agent.",
    "keywords": [
        "ai",
        "agent",
        "coding-agent",
        "llm",
        "laravel",
        "console",
        "cli"
    ],
    "homepage": "https://paider.dev",
    "type": "library",
    "license": "Apache-2.0",
    "support": {
        "issues": "https://github.com/shoemoney/paider/issues",
        "source": "https://github.com/shoemoney/paider"
    },
    "authors": [
        {
            "name": "Jeremy Schoemaker",
            "email": "jeremy@shoemoney.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "laravel-zero/framework": "^12.0.2",
        "laravel/prompts": "^0.3.19"
    },
    "require-dev": {
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.4|^4.1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "paider"
    ]
}
