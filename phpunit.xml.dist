<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>./tests/Feature</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>./tests/Unit</directory>
        </testsuite>
        <testsuite name="Live">
            <directory>./tests/Live</directory>
        </testsuite>
    </testsuites>
    <!--
        Live tests hit real providers and cost real money. Excluded by default so that
        `vendor/bin/pest` stays hermetic and free. Run them explicitly with the CLI flag
        `group=live` (double dash prefix, which cannot be written inside an XML comment).

        The corpus group is the two checks that read ~/.claude/skills. They pass only on a
        machine that has that directory and skip everywhere else, which makes the published
        total a property of the laptop rather than of the suite. Run them with `group=corpus`.
    -->
    <groups>
        <exclude>
            <group>live</group>
            <group>corpus</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>./app</directory>
        </include>
    </source>
</phpunit>
