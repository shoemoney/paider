{
    "alias": "paider.phar",
    "banner": "Paider — https://paider.dev",
    "chmod": "0755",
    "check-requirements": true,
    "directories": [
        "app",
        "bootstrap",
        "config",
        "vendor"
    ],
    "files": [
        "paider",
        "composer.json"
    ],
    "main": "paider",
    "output": "build/paider.phar",
    "stub": true,
    "exclude-composer-files": false,
    "compression": "GZ",
    "compactors": [
        "KevinGH\\Box\\Compactor\\Php",
        "KevinGH\\Box\\Compactor\\Json"
    ]
}
